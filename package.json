{
  "name": "swayforge",
  "productName": "SwayForge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first social content workspace foundation.",
  "main": "src/main/main-process.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node --test tests/application-shell.test.cjs tests/settings-diagnostics.test.cjs tests/quality-foundation.test.cjs tests/release-foundation.test.cjs",
    "test:windows": "node --test tests/windows-paths.test.cjs tests/storage.test.cjs tests/media-foundation.test.cjs tests/windows-packaging.test.cjs",
    "check": "node scripts/check-project.cjs && npm run check:privacy && npm run check:security && npm run check:workflow && npm run check:package",
    "check:privacy": "node scripts/check-privacy.cjs",
    "check:security": "node scripts/check-security.cjs",
    "check:workflow": "node scripts/check-workflows.cjs",
    "check:package": "node scripts/check-package-config.cjs",
    "check:package-output": "node scripts/check-package-output.cjs",
    "check:git": "node scripts/check-git-conventions.mjs",
    "lint": "node scripts/lint-project.cjs",
    "smoke:electron": "node scripts/electron-smoke.cjs",
    "pack:win": "electron-builder --config build/electron-builder.config.cjs --win --x64 --dir --publish never",
    "dist:win": "electron-builder --config build/electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.7"
  }
}
